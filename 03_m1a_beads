    level_numeric_rev = 
      min(level_numeric_rev),
    pc2_score = max(pc2_score) -
      (0.5 *
         (as.numeric(factor(bead_type)) - 1)),
    .groups = 'drop') %>%
  filter(!is.na(equation))

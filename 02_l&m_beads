get_regression_eq <- function(data)
{
  if(nrow(data) < 6) return(NA)
  tryCatch({
    model <- lm(pc1_score ~
                  poly(level_numeric_rev, 2), data = data)
    coefs <- coefficients(model)
    r2 <- summary(model)$adj.r.squared
    equation <- sprintf("y = %.2f % +.2fx %+.2fx²",
                        coefs[1], coefs[2], coefs[3])
    return(paste0(equation, "
                  (R²=", round(r2, 2), ")"))
  }, error = function(e) {
    return(NA)
  })
}
equations_df <- lm_full_adv_data %>%
  group_by(bead_type) %>%

chronological_order <- c(
  "Early",
  "EMT",
  "M1",
  "M2a",
  "M2b",
  "M3",
  "M4",
  "MLT",
  "L1a",
  "L1b",
  "L1c",
  "L2",
  "Mission/Historic"
)
bead_weights <- list(
  "M1a" = 0.3,
  "F" = 0.6,
  "C" = 0.8,
  "default" = 1.0
)
period_weights <- setNames(1:13, chronological_order)
missing_weights <- setdiff(all_periods,
                           names(period_weights))
if  (length(missing_weights) > 0) {
  cat("warning: missing weights for periods:",
      paste(missing_weights, collapse = ", "), "\n")
  for (period in missing_weights) {
    period_weights[period] <- max(period_weights, na.rm = TRUE) +
      1
  }
}

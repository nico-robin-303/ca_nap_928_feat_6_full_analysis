bead_morphology_2 <- feat_6_beads_frags_2 %>%
  mutate(
    width_length_index = width / length,
    perfect_square_diagonal = sqrt(length^2 + width^2),
    angle_index = long_diagonal / perfect_square_diagonal,
    diagonal_index = long_diagonal / short_diagonal,
    perf_width_index = perforation_diameter / width,
    pcurve = (curvature - thickness) / thickness,
    thickness_width_index = thickness / width,
    volume_estimate = length * width * thickness,
    sphericity_index = (36 * pi * volume_estimate^2)^(1/3) / (length + width +thickness)) %>%
  mutate(across(where(is.numeric),
                ~ ifelse(is.infinite(.) | is.nan(.), NA, .)))
cat("bead morphology indices calculated:\n")
glimpse(bead_morphology_2 %>%
          select(bead_type, length, width, width_length_index, angle_index, perf_width_index))
morphology_summary_2 <- bead_morphology_2 %>%
  group_by(bead_type) %>%
  summarise(
    n = n(),
    wl_mean = mean(width_length_index, na.rm = TRUE),
    wl_sd = sd(width_length_index, na.rm = TRUE),
    wl_cv = wl_sd / wl_mean,
    angle_mean = mean(angle_index, na.rm = TRUE),
    angle_sd = sd(angle_index, na.rm = TRUE),
    diag_mean = mean(diagonal_index, na.rm = TRUE),
    diag_sd = sd(diagonal_index, na.rm = TRUE),
    perf_mean = mean(perf_width_index, na.rm = TRUE),
    perf_sd = sd(perf_width_index, na.rm = TRUE),
    pcurv_mean = mean(pcurve, na.rm = TRUE),
    pcurv_sd = sd(pcurve, na.rm = TRUE),
    .groups = "drop") %>%
  filter(n >= 3)
cat("morphological summary by bead type:\n")
print(morphology_summary_2, n = 23)
all_beads_summary_for_table_19 <- bead_morphology_2 %>%
  mutate(
    super_category = case_when(
      shell_type_clean %in% c("bead complete", "bead fragment") ~
        "Beads",
      TRUE ~ "Other/Unidentified"
    )
  ) %>%
  group_by(super_category,
           bead_type, shell_type_clean, bead_frag_portion) %>%
  summarise(
    n = sum(count, na.rm = TRUE),
    mean_diameter = mean(diameter, na.rm = TRUE),
    mean_length = mean(length, na.rm = TRUE),
    mean_width = mean(width, na.rm = TRUE),
    mean_perf_diameter = mean(perforation_diameter, na.rm = TRUE),
    mean_curvature = mean(curvature, na.rm = TRUE),
    mean_thickness = mean(thickness, na.rm = TRUE),
    shelf_p = sum(shelf == "p", na.rm = TRUE),
    shelf_a = sum(shelf == "a", na.rm = TRUE),
    burnt_y = sum(burnt == "y", na.rm = TRUE),
    burnt_n = sum(burnt == "n", na.rm = TRUE),
    mean_angle_index = mean(angle_index, na.rm = TRUE),
    mean_diagonal_index = mean(diagonal_index, na.rm = TRUE),
    mean_perf_width_index = mean(perf_width_index, na.rm = TRUE),
    mean_pcurve = mean(pcurve, na.rm = TRUE),
    mean_thickness_width_index = mean(thickness_width_index, na.rm = TRUE),
    mean_volume_estimate = mean(volume_estimate, na.rm = TRUE),
    mean_sphericity_index = mean(sphericity_index, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(bead_type = case_when(
    is.na(bead_type) ~ paste("-", shell_type_clean),
    shell_type_clean == "bead fragment" ~ paste0(
      bead_type, "<span style='font-size: 10px;'> (</span>", 
      case_when(
        bead_frag_portion == "1 quarter" ~ "<span style='font-size: 10px;'>¼ bead</span>",
        bead_frag_portion == "half" ~ "<span style='font-size: 10px;'>½ bead</span>",
        bead_frag_portion == "3 quarter" ~ "<span style='font-size: 10px;'>¾ bead</span>",
        bead_frag_portion == "2 halves" ~ "<span style='font-size: 10px;'>re-fit: ½ + ½</span>",
        bead_frag_portion == "half, 1 quarter" ~ "<span style='font-size: 10px;'>re-fit: ½ + ¼</span>",
        is.na(bead_frag_portion) ~ "<span style='font-size: 10px;'>frag</span>",
        is.nan(bead_frag_portion) ~ "<span style='font-size: 10px;'>frag</span>",
        TRUE ~ bead_frag_portion
      ),
      "<span style='font-size: 10px;'>)</span>"
    ),
    TRUE ~ as.character(bead_type)
  )
  ) %>%
  arrange(super_category, bead_type)
View(all_beads_summary_for_table_19)

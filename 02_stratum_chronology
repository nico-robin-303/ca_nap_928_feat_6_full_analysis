abundance_matrix_strats <- feat_6_beads_frags %>%
  filter(!is.na(bead_type), !is.na(stratum)) %>%
  count(stratum, bead_type) %>%
  pivot_wider(names_from = bead_type, values_from = n, values_fill = 0) %>%
  column_to_rownames("stratum") %>%
  as.matrix()
cat("Matrix dimensions:",
    dim(abundance_matrix_strats),
    "\n")
cat("Strata:", 
    rownames(abundance_matrix_strats),
    "\n")
cat("Total beads:",
    sum(abundance_matrix_strats),
    "\n")
abundance_df_strats <- abundance_matrix_strats %>%
  as.data.frame() %>%
  rownames_to_column("stratum")
cat("Columns in abundance data:",
    paste(colnames(abundance_df_strats),
          collapse = ", "), "\n")
cat("Bead types in abundance data:",
    length(colnames(abundance_df_strats)) -1,
    "types\n")
cat("Columns in Scheme D1 Reference:",
    paste(colnames(scheme_d1_reference),
          collapse = ", "), "\n")
cat("Bead types in Scheme D1 Reference:",
    nrow(scheme_d1_reference),
    "types\n")
presence_long_strats <- abundance_df_strats %>%
  mutate(across(-stratum, ~ as.numeric(. > 0))) %>%
  pivot_longer(
    cols = -stratum,
    names_to = "bead_type_assemblage",
    values_to = "present"
  )
cat("after full pivot_longer - columns:", 
    paste(colnames(presence_long_strats),
          collapse = ", "), "\n")
cat("number of rows in presence_long_strats:",
    nrow(presence_long_strats), "\n")
joined_data_strats <- presence_long_strats %>%
  left_join(
    scheme_d1_reference,
    by = "bead_type_assemblage"
  )
cat("After join - rows with NA time_period (not in scheme_d1_reference):",
    sum(is.na(joined_data_strats$time_period)), "\n")
cat("After join - rows with time_period (in scheme_d1_reference):",
    sum(!is.na(joined_data_strats$time_period)), "\n")
complete_joined_data_strats <- joined_data_strats %>%
  filter(!is.na(time_period)) %>%
  complete(stratum, time_period = chronological_order, fill = list(present = 0))
cat("2. after cleaningand completing - unique time periods:\n")
print(unique(complete_joined_data_strats$time_period))
cat("number of periods:",
    length(unique(complete_joined_data_strats$time_period)), "\n")
periods_complete_strats <- unique(complete_joined_data_strats$time_period)
period_affinity_strats <- complete_joined_data_strats %>%
  group_by(stratum, time_period) %>%
  summarise(affinity_score = sum(present) / n(), .groups = "drop") %>%
  pivot_wider(names_from = time_period, values_from = affinity_score) %>%
  column_to_rownames("stratum") %>%
  as.matrix()
cat("fixed period affinity matrix columns:\n")
print(colnames(period_affinity_strats))
stratum_chronology_fixed <- period_affinity_strats %>%
  as.data.frame() %>%
  rownames_to_column("stratum")
manual_chronology_strats <- period_affinity_strats %>%
  as.data.frame() %>%
  rownames_to_column("stratum")
manual_chronology_strats$assigned_period <- NA
manual_chronology_strats$max_affinity <- NA
manual_chronology_strats$second_affinity <- NA
manual_chronology_strats$confidence <- NA
for(i in 1:nrow(manual_chronology_strats)) {
  row_values_strats <- as.numeric(manual_chronology_strats[i, chronological_order])
  max_index_strats <- which.max(row_values_strats)
  manual_chronology_strats$max_affinity[i] <- row_values_strats[max_index_strats]
  manual_chronology_strats$assigned_period[i] <- chronological_order[max_index_strats]
  sorted_values_strats <- sort(row_values_strats, decreasing = TRUE)
  manual_chronology_strats$second_affinity[i] <- ifelse(length(sorted_values_strats) >= 2, sorted_values_strats[2], 0)
  manual_chronology_strats$confidence[i] <- manual_chronology_strats$max_affinity[i] - manual_chronology_strats$second_affinity[i]
}
stratum_chronology_ordered <- manual_chronology_strats %>%
  mutate(stratum = factor(stratum, levels = c("3c", "3b", "3a", "3", "house floor", "2")),
         assigned_period = factor(assigned_period, levels = chronological_order, labels = chronological_order))
cat("assigned period factor levels:\n")
print(levels(stratum_chronology_ordered$assigned_period))
cat("unique assigned periods in data:\n")
print(unique(stratum_chronology_ordered$assigned_period))
stratum_chronology_ordered
stratum_chronology_plot <- ggplot(stratum_chronology_ordered,
                                  aes(x= stratum, y = max_affinity)) +
  geom_point(aes(size = confidence, fill = assigned_period),
             alpha = 0.7, shape = 21, color = "black", stroke = 0.5) +
  scale_size_continuous(
    name = "Confidence",
    range = c(8, 16),
    limits = c(0, 1)
  ) +
  scale_fill_manual(name = "Assigned Period", values = diverging_13_rev,
                    guide = guide_legend(override.aes = list(size = 4))
  ) +
  labs(
    title = "Chronological Period Assignments by Stratum Sample",
    subtitle = "Circle Size =  confidence level | Color = assigned period\nSmall circles indicate uncertain assignments",
    x = "Stratum (Earliest → Latest)",
    y = "Maximum Period Affinity"
  ) +
  theme_minimal() +
  theme(
    text = element_text(family = "Avenir"),
    plot.title = element_text(size = 16, face = "bold", hjust = 0.5),
    plot.subtitle = element_text(size = 11, color = "gray40", hjust = 0.5),
    axis.title = element_text(size = 12, face = "bold"),
    axis.text = element_text(size = 10),
    axis.text.x = element_text(angle = 45, hjust = 1),
    legend.title = element_text(face = "bold", size = 11),
    legend.text = element_text(size = 9),
    legend.key.height = unit(10, "pt"),
    legend.key.width = unit(10, "pt")
  ) +
  geom_text(aes(label = round(max_affinity, 2)),
            size = 3, color = "black", fontface = "bold")
stratum_chronology_plot

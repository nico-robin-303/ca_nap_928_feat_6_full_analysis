feature_6_bead_map <- plot_ly() %>%
  add_surface(
    x = floor_surface_matrix$x,
    y = floor_surface_matrix$y,
    z = floor_surface_matrix$z,
    colorscale = list(c(0, 1), c('saddlebrown', 'tan')),
    opacity = 3,
    name = "House Floor",
    showscale = FALSE,
    contours = list(z = list(
      show = TRUE,
      usecolormap = TRUE,
      highlightcolor = "#ff0000",
      project = list(z = TRUE)
    ))
  ) %>%
  add_trace(
    data = unit_wireframes,
    x = ~easting,
    y = ~northing,
    z = ~depth,
    type = 'scatter3d',
    mode = 'lines',
    line = list(color = 'orange', width = 2,  simplify = FALSE),
    opacity = 0.8,
    name = "Excavation Units",
    showlegend = TRUE,
    hoverinfo = 'none'
  )
feature_6_bead_map <- feature_6_bead_map %>%
  add_trace(
    data = all_artifact_spatial_data %>%
      filter(data_type == "unit/level"),
    x = ~aggregate_easting,
    y = ~aggregate_northing,
    z = ~aggregate_depth,
    type = 'scatter3d',
    mode = 'markers',
    marker = list(
      size = ~sqrt(pmax(total_beads, 0) + 1) * 6,
      color = ~pmax(total_beads, 0),
      colorscale = list(c(0, 0.3, 0.6, 1),
                        c('lightblue', 'blue', 'darkblue', 'navy')),
      colorbar = list(
        title = "Bead Count", len = 0.35, y = 0.8, yanchor = "top", x = 1.05,
        xanchor = "left", titlefont = list(size = 11), tickfont = list(size = 9)),
      symbol = 'circle',
      line = list(width = 1, color = 'white')
    ),
    name = "Unit Beads",
    text = ~paste("<b>Context:", context_id, "</b><br>",
    "Level:", aggregate_depth, "<br>", "Beads:", total_beads
    ),
    hoverinfo = 'text'
  ) %>%
  add_trace(
    data = all_artifact_spatial_data %>%
      filter(data_type == "feature/burial"),
    x = ~aggregate_easting,
    y = ~aggregate_northing,
    z = ~aggregate_depth,
    type = 'scatter3d',
    mode = 'markers',
    marker = list(
      size = ~sqrt(pmax(total_beads, 0) + 1) * 3,
      color = ~pmax(total_shell_weight, 0),
      colorscale = list(c(0, 0.5, 1),
                        c('lightcoral', 'red', 'darkred')),
      symbol = 'diamond',
      line = list(width = 1, color = 'black')
    ),
    name = "Features/Burials",
    text = ~paste("<b>Context:", context_id, "</b><br>",
    "Level:", aggregate_depth, "<br>", "Beads:", total_beads
    ),
    hoverinfo = 'text'
  ) %>%
  add_trace(
    data = all_artifact_spatial_data,
    x = ~aggregate_easting,
    y = ~aggregate_northing,
    z = ~aggregate_depth,
    type = 'scatter3d',
    mode = 'markers',
    marker = list(
      size = ~sqrt(pmax(total_shell_count, 0) + 1) * 3,
      color = ~pmax(total_shell_weight, 0),
      colorscale = list(c(0, 0.3, 0.6, 1),
                        c('lightgoldenrodyellow', 'lightgoldenrod', 'gold', 'goldenrod')),
      colorbar = list(
        title = "Shell Weight (g)", len = 0.35, y = 0.35, yanchor = "top", x = 1.05,
        xanchor = "left", titlefont = list(size = 11), tickfont = list(size = 9)),
      symbol = 'square',
      line = list(width = 1, color = 'gray')
    ),
    name = "Detritus",
    text = ~paste("<b>Context:", context_id, "</b><br>",
                  "Level:", aggregate_depth, "<br>", "Shell Pieces:", total_shell_count,
                  "<br>Shell wt:", total_shell_weight, "g"
    ),
    hoverinfo = 'text'
  ) %>%
  layout(
    title = list(
      text = "<b>Distribution of Shell Beads and Detritus within Feature 6 House Floor</b>",
      font = list(size = 16)),
    scene = list(
      xaxis = list(title = "Easting (m)", gridcolor = 'lightgray'),
      yaxis = list(title = "Northing (m)", gridcolor = 'lightgray'),
      zaxis = list(title = "Depth (cm)", autorange = "reversed", gridcolor = 'lightgray'),
      aspectmode = "manual",
      aspectratio = list(x = 1, y = 1, z = 0.5
    ),
    camera = list(eye = list(x = 0.4, y = -1, z = 0.6),
                  up = list(x = 0, y = 0, z = 7))),
    legend = list(
      orientation = "v",
      x = 0.1,
      y = 0.05,
      font = list(size = 10)
    ),
    margin = list(
      l = 0, r = 0, b = 0, t = 40)
  )
feature_6_bead_map
